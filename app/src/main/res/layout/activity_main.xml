package com.broken.photoeditor

import android.content.ContentValues
import android.content.res.ColorStateList
import android.graphics.Bitmap
import android.graphics.BitmapFactory
import android.graphics.Canvas
import android.graphics.Color
import android.graphics.Matrix
import android.graphics.Paint
import android.net.Uri
import android.os.Build
import android.os.Bundle
import android.provider.MediaStore
import android.view.View
import android.widget.ImageView
import android.widget.LinearLayout
import android.widget.SeekBar
import android.widget.TextView
import android.widget.Toast
import androidx.activity.result.contract.ActivityResultContracts
import androidx.appcompat.app.AlertDialog
import androidx.appcompat.app.AppCompatActivity
import androidx.core.content.res.ResourcesCompat
import com.google.android.material.button.MaterialButton
import java.io.InputStream
import java.io.OutputStream
import kotlin.math.roundToInt

class MainActivity : AppCompatActivity() {

    private lateinit var rootLayout: LinearLayout
    private lateinit var previewPanel: LinearLayout
    private lateinit var photoView: ImageView
    private lateinit var statusText: TextView
    private lateinit var settingsButton: MaterialButton
    private lateinit var openButton: MaterialButton
    private lateinit var saveButton: MaterialButton
    private lateinit var cropButton: MaterialButton
    private lateinit var rotateButton: MaterialButton
    private lateinit var textButton: MaterialButton
    private lateinit var stickerButton: MaterialButton
    private lateinit var compareButton: MaterialButton
    private lateinit var addLayerButton: MaterialButton
    private lateinit var toggleLayerButton: MaterialButton
    private lateinit var deleteLayerButton: MaterialButton
    private lateinit var layerListContainer: LinearLayout
    private lateinit var themeMidnightButton: MaterialButton
    private lateinit var themeSunsetButton: MaterialButton
    private lateinit var themeForestButton: MaterialButton
    private lateinit var themeAuroraButton: MaterialButton
    private lateinit var themeClassicButton: MaterialButton
    private lateinit var filterNormalButton: MaterialButton
    private lateinit var filterBwButton: MaterialButton
    private lateinit var filterWarmButton: MaterialButton
    private lateinit var filterCoolButton: MaterialButton
    private lateinit var filterVintageButton: MaterialButton
    private lateinit var brightnessSeek: SeekBar
    private lateinit var contrastSeek: SeekBar
    private lateinit var saturationSeek: SeekBar

    private data class ThemePalette(
        val background: Int,
        val panel: Int,
        val imageSurface: Int,
        val primary: Int,
        val accent: Int,
        val textPrimary: Int,
        val textSecondary: Int,
        val actionText: Int
    )

    private data class EditorLayer(
        val id: Int,
        var name: String,
        var visible: Boolean = true,
        var opacity: Float = 1f
    )

    private enum class PhotoFilter { NORMAL, BLACK_AND_WHITE, WARM, COOL, VINTAGE }

    private var originalBitmap: Bitmap? = null
    private var currentRotation = 0
    private var selectedLayerId = 1
    private var currentTheme = "Midnight"
    private var compareMode = false
    private var selectedFilter = PhotoFilter.NORMAL

    private val layers = mutableListOf(
        EditorLayer(1, "Background", true, 1f),
        EditorLayer(2, "Adjustment", true, 1f),
        EditorLayer(3, "FX", true, 1f),
        EditorLayer(4, "Text", true, 1f)
    )

    private val pickImage = registerForActivityResult(ActivityResultContracts.GetContent()) { uri: Uri? ->
        if (uri == null) {
            Toast.makeText(this, "No image selected", Toast.LENGTH_SHORT).show()
            return@registerForActivityResult
        }
        try {
            val inputStream: InputStream? = contentResolver.openInputStream(uri)
            val bitmap = BitmapFactory.decodeStream(inputStream)
            inputStream?.close()
            if (bitmap != null) {
                originalBitmap = bitmap.copy(Bitmap.Config.ARGB_8888, true)
                currentRotation = 0
                renderPreview()
                Toast.makeText(this, "Image loaded successfully", Toast.LENGTH_SHORT).show()
            } else {
                Toast.makeText(this, "Could not open selected image", Toast.LENGTH_SHORT).show()
            }
        } catch (e: Exception) {
            Toast.makeText(this, "Image open failed: ${e.message}", Toast.LENGTH_LONG).show()
        }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_main)

        bindViews()
        setupListeners()
        setupThemeButtons()
        brightnessSeek.progress = 100
        contrastSeek.progress = 100
        saturationSeek.progress = 100
        setDefaultFilterSelection()
        updateLayerList()
        applyTheme(currentTheme)
        statusText.text = "Ready • Full Frame"
        renderPreview()
    }

    private fun bindViews() {
        rootLayout = findViewById(R.id.rootLayout)
        previewPanel = findViewById(R.id.previewPanel)
        photoView = findViewById(R.id.photoView)
        statusText = findViewById(R.id.statusText)
        settingsButton = findViewById(R.id.settingsButton)
        openButton = findViewById(R.id.openButton)
        saveButton = findViewById(R.id.saveButton)
        cropButton = findViewById(R.id.cropButton)
        rotateButton = findViewById(R.id.rotateButton)
        textButton = findViewById(R.id.textButton)
        stickerButton = findViewById(R.id.stickerButton)
        compareButton = findViewById(R.id.compareButton)
        addLayerButton = findViewById(R.id.addLayerButton)
        toggleLayerButton = findViewById(R.id.toggleLayerButton)
        deleteLayerButton = findViewById(R.id.deleteLayerButton)
        layerListContainer = findViewById(R.id.layerListContainer)
        themeMidnightButton = findViewById(R.id.themeMidnight)
        themeSunsetButton = findViewById(R.id.themeSunset)
        themeForestButton = findViewById(R.id.themeForest)
        themeAuroraButton = findViewById(R.id.themeAurora)
        themeClassicButton = findViewById(R.id.themeClassic)
        filterNormalButton = findViewById(R.id.filterNormal)
        filterBwButton = findViewById(R.id.filterBlackWhite)
        filterWarmButton = findViewById(R.id.filterWarm)
        filterCoolButton = findViewById(R.id.filterCool)
        filterVintageButton = findViewById(R.id.filterVintage)
        brightnessSeek = findViewById(R.id.brightnessSeekBar)
        contrastSeek = findViewById(R.id.contrastSeekBar)
        saturationSeek = findViewById(R.id.saturationSeekBar)
    }

    private fun setupThemeButtons() {
        themeMidnightButton.setOnClickListener { currentTheme = "Midnight"; applyTheme(currentTheme) }
        themeSunsetButton.setOnClickListener { currentTheme = "Sunset"; applyTheme(currentTheme) }
        themeForestButton.setOnClickListener { currentTheme = "Forest"; applyTheme(currentTheme) }
        themeAuroraButton.setOnClickListener { currentTheme = "Aurora"; applyTheme(currentTheme) }
        themeClassicButton.setOnClickListener { currentTheme = "Classic"; applyTheme(currentTheme) }
    }

    private fun setupListeners() {
        settingsButton.setOnClickListener { showThemeDialog() }
        openButton.setOnClickListener { pickImage.launch("image/*") }

        cropButton.setOnClickListener {
            if (originalBitmap == null) {
                Toast.makeText(this, "Load an image before cropping", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }
            val cropped = cropSquare(originalBitmap!!)
            originalBitmap = cropped
            currentRotation = 0
            renderPreview()
            statusText.text = "Crop applied • Center focus"
            Toast.makeText(this, "Image cropped to square", Toast.LENGTH_SHORT).show()
        }

        rotateButton.setOnClickListener {
            if (originalBitmap == null) {
                Toast.makeText(this, "Open an image first", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }
            currentRotation = (currentRotation + 90) % 360
            renderPreview()
            statusText.text = "Rotation • ${currentRotation}°"
        }

        textButton.setOnClickListener {
            if (originalBitmap == null) {
                Toast.makeText(this, "Select an image first", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }
            addTextOverlay("PRO")
        }

        stickerButton.setOnClickListener {
            if (originalBitmap == null) {
                Toast.makeText(this, "Select an image first", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }
            addStickerOverlay()
        }

        compareButton.setOnClickListener {
            compareMode = !compareMode
            statusText.text = if (compareMode) "Compare • Before / After" else "Ready • Full Frame"
            renderPreview()
            Toast.makeText(this, if (compareMode) "Comparison mode enabled" else "Comparison mode disabled", Toast.LENGTH_SHORT).show()
        }

        addLayerButton.setOnClickListener {
            val nextId = (layers.maxOfOrNull { it.id } ?: 0) + 1
            layers.add(EditorLayer(nextId, "Layer $nextId", true, 1f))
            selectedLayerId = nextId
            updateLayerList()
            Toast.makeText(this, "Added new layer", Toast.LENGTH_SHORT).show()
        }

        toggleLayerButton.setOnClickListener {
            val selected = layers.firstOrNull { it.id == selectedLayerId }
            if (selected != null) {
                selected.visible = !selected.visible
                Toast.makeText(this, "${selected.name} ${if (selected.visible) "visible" else "hidden"}", Toast.LENGTH_SHORT).show()
                updateLayerList()
            }
        }

        deleteLayerButton.setOnClickListener {
            if (layers.size <= 1) {
                Toast.makeText(this, "At least one layer is required", Toast.LENGTH_SHORT).show()
                return@setOnClickListener
            }
            val index = layers.indexOfFirst { it.id == selectedLayerId }
            if (index >= 0) {
                layers.removeAt(index)
                selectedLayerId = layers.first().id
                updateLayerList()
                Toast.makeText(this, "Layer deleted", Toast.LENGTH_SHORT).show()
            }
        }

        saveButton.setOnClickListener { showExportDialog() }

        filterNormalButton.setOnClickListener {
            selectedFilter = PhotoFilter.NORMAL; setDefaultFilterSelection(); renderPreview()
        }
        filterBwButton.setOnClickListener {
            selectedFilter = PhotoFilter.BLACK_AND_WHITE; setDefaultFilterSelection(); renderPreview()
        }
        filterWarmButton.setOnClickListener {
            selectedFilter = PhotoFilter.WARM; setDefaultFilterSelection(); renderPreview()
        }
        filterCoolButton.setOnClickListener {
            selectedFilter = PhotoFilter.COOL; setDefaultFilterSelection(); renderPreview()
        }
        filterVintageButton.setOnClickListener {
            selectedFilter = PhotoFilter.VINTAGE; setDefaultFilterSelection(); renderPreview()
        }

        brightnessSeek.setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
            override fun onProgressChanged(seekBar: SeekBar?, progress: Int, fromUser: Boolean) = renderPreview()
            override fun onStartTrackingTouch(seekBar: SeekBar?) = Unit
            override fun onStopTrackingTouch(seekBar: SeekBar?) = Unit
        })
        contrastSeek.setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
            override fun onProgressChanged(seekBar: SeekBar?, progress: Int, fromUser: Boolean) = renderPreview()
            override fun onStartTrackingTouch(seekBar: SeekBar?) = Unit
            override fun onStopTrackingTouch(seekBar: SeekBar?) = Unit
        })
        saturationSeek.setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
            override fun onProgressChanged(seekBar: SeekBar?, progress: Int, fromUser: Boolean) = renderPreview()
            override fun onStartTrackingTouch(seekBar: SeekBar?) = Unit
            override fun onStopTrackingTouch(seekBar: SeekBar?) = Unit
        })
    }

    private fun updateLayerList() {
        layerListContainer.removeAllViews()
        for (layer in layers) {
            val button = MaterialButton(this).apply {
                text = "${if (layer.visible) "✓" else "○"} ${layer.name}"
                setTextSize(10f)
                minHeight = 0
                height = 52
                setPadding(18, 8, 18, 8)
                cornerRadius = 18
                isSelected = layer.id == selectedLayerId
                backgroundTintList = ColorStateList.valueOf(
                    if (layer.id == selectedLayerId) ResourcesCompat.getColor(resources, R.color.accent, theme)
                    else ResourcesCompat.getColor(resources, R.color.surface_variant, theme)
                )
                setTextColor(
                    if (layer.id == selectedLayerId) ResourcesCompat.getColor(resources, R.color.on_accent, theme)
                    else ResourcesCompat.getColor(resources, R.color.text_primary, theme)
                )
                setOnClickListener {
                    selectedLayerId = layer.id
                    updateLayerList()
                    Toast.makeText(this@MainActivity, "Selected ${layer.name}", Toast.LENGTH_SHORT).show()
                }
            }
            layerListContainer.addView(button)
        }
    }

    private fun showThemeDialog() {
        val themes = arrayOf("Midnight", "Sunset", "Forest", "Aurora", "Classic")
        val currentIndex = themes.indexOf(currentTheme).takeIf { it >= 0 } ?: 0
        AlertDialog.Builder(this)
            .setTitle("Choose Theme")
            .setSingleChoiceItems(themes, currentIndex) { dialog, which ->
                currentTheme = themes[which]
                applyTheme(currentTheme)
                dialog.dismiss()
            }
            .show()
    }

    private fun applyTheme(themeName: String) {
        val palette = when (themeName) {
            "Sunset" -> ThemePalette(
                background = Color.parseColor("#1d0f1c"),
                panel = Color.parseColor("#2f1b2d"),
                imageSurface = Color.parseColor("#402635"),
                primary = Color.parseColor("#ff8a65"),
                accent = Color.parseColor("#ff6f61"),
                textPrimary = Color.parseColor("#fff6f8"),
                textSecondary = Color.parseColor("#f9d6d3"),
                actionText = Color.parseColor("#ffffff")
            )
            "Forest" -> ThemePalette(
                background = Color.parseColor("#081b12"),
                panel = Color.parseColor("#102a1c"),
                imageSurface = Color.parseColor("#163a2a"),
                primary = Color.parseColor("#57b65f"),
                accent = Color.parseColor("#8bc34a"),
                textPrimary = Color.parseColor("#edf9ef"),
                textSecondary = Color.parseColor("#d3ebd7"),
                actionText = Color.parseColor("#ffffff")
            )
            "Aurora" -> ThemePalette(
                background = Color.parseColor("#071b28"),
                panel = Color.parseColor("#0f2c3e"),
                imageSurface = Color.parseColor("#163c50"),
                primary = Color.parseColor("#00bcd4"),
                accent = Color.parseColor("#66d9ef"),
                textPrimary = Color.parseColor("#edfaff"),
                textSecondary = Color.parseColor("#d7f8ff"),
                actionText = Color.parseColor("#ffffff")
            )
            "Classic" -> ThemePalette(
                background = Color.parseColor("#111111"),
                panel = Color.parseColor("#1f1f1f"),
                imageSurface = Color.parseColor("#2a2a2a"),
                primary = Color.parseColor("#d4af37"),
                accent = Color.parseColor("#f6d365"),
                textPrimary = Color.parseColor("#f8f8f8"),
                textSecondary = Color.parseColor("#e5e5e5"),
                actionText = Color.parseColor("#111111")
            )
            else -> ThemePalette(
                background = Color.parseColor("#0d1322"),
                panel = Color.parseColor("#171f35"),
                imageSurface = Color.parseColor("#1e2a42"),
                primary = Color.parseColor("#6c63ff"),
                accent = Color.parseColor("#8b7dff"),
                textPrimary = Color.parseColor("#f5f8ff"),
                textSecondary = Color.parseColor("#d8e1ff"),
                actionText = Color.parseColor("#ffffff")
            )
        }

        rootLayout.setBackgroundColor(palette.background)
        previewPanel.setBackgroundColor(palette.panel)
        photoView.setBackgroundColor(palette.imageSurface)
        statusText.setTextColor(palette.textSecondary)
        window.statusBarColor = palette.background
        window.navigationBarColor = palette.background

        listOf(openButton, saveButton, cropButton, rotateButton, textButton, stickerButton, compareButton, addLayerButton, toggleLayerButton, deleteLayerButton, settingsButton).forEach { button ->
            button.backgroundTintList = ColorStateList.valueOf(palette.primary)
            button.setTextColor(palette.actionText)
        }

        themeMidnightButton.backgroundTintList = ColorStateList.valueOf(if (themeName == "Midnight") palette.accent else palette.panel)
        themeSunsetButton.backgroundTintList = ColorStateList.valueOf(if (themeName == "Sunset") palette.accent else palette.panel)
        themeForestButton.backgroundTintList = ColorStateList.valueOf(if (themeName == "Forest") palette.accent else palette.panel)
        themeAuroraButton.backgroundTintList = ColorStateList.valueOf(if (themeName == "Aurora") palette.accent else palette.panel)
        themeClassicButton.backgroundTintList = ColorStateList.valueOf(if (themeName == "Classic") palette.accent else palette.panel)
        listOf(themeMidnightButton, themeSunsetButton, themeForestButton, themeAuroraButton, themeClassicButton).forEach { it.setTextColor(palette.actionText) }

        filterNormalButton.backgroundTintList = ColorStateList.valueOf(if (selectedFilter == PhotoFilter.NORMAL) palette.accent else palette.panel)
        filterBwButton.backgroundTintList = ColorStateList.valueOf(if (selectedFilter == PhotoFilter.BLACK_AND_WHITE) palette.accent else palette.panel)
        filterWarmButton.backgroundTintList = ColorStateList.valueOf(if (selectedFilter == PhotoFilter.WARM) palette.accent else palette.panel)
        filterCoolButton.backgroundTintList = ColorStateList.valueOf(if (selectedFilter == PhotoFilter.COOL) palette.accent else palette.panel)
        filterVintageButton.backgroundTintList = ColorStateList.valueOf(if (selectedFilter == PhotoFilter.VINTAGE) palette.accent else palette.panel)
        listOf(filterNormalButton, filterBwButton, filterWarmButton, filterCoolButton, filterVintageButton).forEach { it.setTextColor(palette.actionText) }

        updateLayerList()
    }

    private fun setDefaultFilterSelection() {
        filterNormalButton.isSelected = selectedFilter == PhotoFilter.NORMAL
        filterBwButton.isSelected = selectedFilter == PhotoFilter.BLACK_AND_WHITE
        filterWarmButton.isSelected = selectedFilter == PhotoFilter.WARM
        filterCoolButton.isSelected = selectedFilter == PhotoFilter.COOL
        filterVintageButton.isSelected = selectedFilter == PhotoFilter.VINTAGE
        setFilterButtonStyle(filterNormalButton)
        setFilterButtonStyle(filterBwButton)
        setFilterButtonStyle(filterWarmButton)
        setFilterButtonStyle(filterCoolButton)
        setFilterButtonStyle(filterVintageButton)
    }

    private fun setFilterButtonStyle(button: MaterialButton) {
        val selected = button.isSelected
        button.backgroundTintList = ColorStateList.valueOf(
            if (selected) ResourcesCompat.getColor(resources, R.color.accent, theme)
            else ResourcesCompat.getColor(resources, R.color.surface_variant, theme)
        )
        button.setTextColor(ResourcesCompat.getColor(resources, R.color.on_accent, theme))
    }

    private fun renderPreview() {
        if (originalBitmap == null) {
            photoView.setImageDrawable(ResourcesCompat.getDrawable(resources, R.drawable.ic_photo_editor, theme))
            return
        }
        val displayBitmap = if (compareMode) originalBitmap else renderEditedBitmap(originalBitmap)
        if (displayBitmap != null) {
            photoView.setImageBitmap(displayBitmap)
        }
    }

    private fun renderEditedBitmap(source: Bitmap?): Bitmap? {
        if (source == null) return null
        val bitmap = if (currentRotation == 0) source.copy(Bitmap.Config.ARGB_8888, true) else rotateBitmap(source, currentRotation.toFloat())
        val brightnessOffset = brightnessSeek.progress - 100
        val contrastValue = contrastSeek.progress / 100f
        val saturationValue = saturationSeek.progress / 100f

        val output = Bitmap.createBitmap(bitmap.width, bitmap.height, Bitmap.Config.ARGB_8888)
        for (y in 0 until bitmap.height) {
            for (x in 0 until bitmap.width) {
                val pixel = bitmap.getPixel(x, y)
                var red = Color.red(pixel)
                var green = Color.green(pixel)
                var blue = Color.blue(pixel)
                val alpha = Color.alpha(pixel)

                when (selectedFilter) {
                    PhotoFilter.BLACK_AND_WHITE -> {
                        val gray = (red * 0.299 + green * 0.587 + blue * 0.114).roundToInt()
                        red = gray; green = gray; blue = gray
                    }
                    PhotoFilter.WARM -> {
                        red = (red * 1.12f).toInt().coerceIn(0, 255)
                        green = (green * 1.06f).toInt().coerceIn(0, 255)
                        blue = (blue * 0.90f).toInt().coerceIn(0, 255)
                    }
                    PhotoFilter.COOL -> {
                        red = (red * 0.92f).toInt().coerceIn(0, 255)
                        green = (green * 0.98f).toInt().coerceIn(0, 255)
                        blue = (blue * 1.18f).toInt().coerceIn(0, 255)
                    }
                    PhotoFilter.VINTAGE -> {
                        val r = red.toFloat(); val g = green.toFloat(); val b = blue.toFloat()
                        red = (r * 0.94f + g * 0.76f + b * 0.53f).toInt().coerceIn(0, 255)
                        green = (r * 0.63f + g * 0.55f + b * 0.44f).toInt().coerceIn(0, 255)
                        blue = (r * 0.47f + g * 0.40f + b * 0.36f).toInt().coerceIn(0, 255)
                    }
                    PhotoFilter.NORMAL -> Unit
                }

                red = (red + brightnessOffset).coerceIn(0, 255)
                green = (green + brightnessOffset).coerceIn(0, 255)
                blue = (blue + brightnessOffset).coerceIn(0, 255)

                val contrastFactor = if (contrastValue == 0f) 1f else (259f * (contrastValue * 255f + 255f)) / (255f * (259f - contrastValue * 255f))
                red = ((contrastFactor * (red - 128) + 128)).toInt().coerceIn(0, 255)
                green = ((contrastFactor * (green - 128) + 128)).toInt().coerceIn(0, 255)
                blue = ((contrastFactor * (blue - 128) + 128)).toInt().coerceIn(0, 255)

                val luminance = red * 0.299f + green * 0.587f + blue * 0.114f
                val saturationFactor = saturationValue
                red = ((luminance + (red - luminance) * saturationFactor)).toInt().coerceIn(0, 255)
                green = ((luminance + (green - luminance) * saturationFactor)).toInt().coerceIn(0, 255)
                blue = ((luminance + (blue - luminance) * saturationFactor)).toInt().coerceIn(0, 255)

                output.setPixel(x, y, Color.argb(alpha, red, green, blue))
            }
        }
        return output
    }

    private fun rotateBitmap(source: Bitmap, degrees: Float): Bitmap {
        val matrix = Matrix()
        matrix.postRotate(degrees)
        return Bitmap.createBitmap(source, 0, 0, source.width, source.height, matrix, true)
    }

    private fun cropSquare(source: Bitmap): Bitmap {
        val size = source.width.coerceAtMost(source.height)
        val x = ((source.width - size) / 2f).toInt()
        val y = ((source.height - size) / 2f).toInt()
        return Bitmap.createBitmap(source, x, y, size, size)
    }

    private fun addTextOverlay(text: String) {
        val base = renderEditedBitmap(originalBitmap) ?: return
        val overlay = base.copy(Bitmap.Config.ARGB_8888, true)
        val canvas = Canvas(overlay)
        val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = Color.WHITE
            textSize = (overlay.width * 0.12f)
            isFakeBoldText = true
            textAlign = Paint.Align.CENTER
            alpha = 220
        }
        canvas.drawText(text, overlay.width * 0.5f, overlay.height * 0.25f, paint)
        originalBitmap = overlay
        renderPreview()
        Toast.makeText(this, "Text overlay applied", Toast.LENGTH_SHORT).show()
    }

    private fun addStickerOverlay() {
        val base = renderEditedBitmap(originalBitmap) ?: return
        val overlay = base.copy(Bitmap.Config.ARGB_8888, true)
        val canvas = Canvas(overlay)
        val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = Color.parseColor("#66d9ef")
            style = Paint.Style.FILL
        }
        val cx = overlay.width * 0.75f
        val cy = overlay.height * 0.75f
        val radius = overlay.width * 0.1f
        canvas.drawCircle(cx, cy, radius, paint)
        val inner = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            color = Color.WHITE
            alpha = 180
        }
        canvas.drawCircle(cx, cy, radius * 0.38f, inner)
        originalBitmap = overlay
        renderPreview()
        Toast.makeText(this, "Sticker overlay applied", Toast.LENGTH_SHORT).show()
    }

    private fun showExportDialog() {
        if (originalBitmap == null) {
            Toast.makeText(this, "Load an image before exporting", Toast.LENGTH_SHORT).show()
            return
        }
        val options = arrayOf("PNG", "JPEG", "WEBP")
        AlertDialog.Builder(this)
            .setTitle("Export Format")
            .setItems(options) { dialog, which ->
                val outputFormat = when (which) {
                    0 -> Bitmap.CompressFormat.PNG
                    1 -> Bitmap.CompressFormat.JPEG
                    else -> Bitmap.CompressFormat.WEBP
                }
                saveBitmapToGallery(renderEditedBitmap(originalBitmap)!!, outputFormat)
                dialog.dismiss()
            }
            .show()
    }

    private fun saveBitmapToGallery(bitmap: Bitmap, format: Bitmap.CompressFormat = Bitmap.CompressFormat.PNG) {
        val fileName = "PE_photo_${System.currentTimeMillis()}${when (format) { Bitmap.CompressFormat.PNG -> ".png"; Bitmap.CompressFormat.JPEG -> ".jpg"; else -> ".webp" }}"
        val values = ContentValues().apply {
            put(MediaStore.MediaColumns.DISPLAY_NAME, fileName)
            put(MediaStore.MediaColumns.MIME_TYPE, when (format) {
                Bitmap.CompressFormat.PNG -> "image/png"
                Bitmap.CompressFormat.JPEG -> "image/jpeg"
                else -> "image/webp"
            })
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                put(MediaStore.MediaColumns.RELATIVE_PATH, "Pictures/PEPhotoEditor")
            }
        }
        val uri: Uri? = contentResolver.insert(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, values)
        if (uri == null) {
            Toast.makeText(this, "Unable to create export file", Toast.LENGTH_SHORT).show()
            return
        }
        try {
            val output: OutputStream? = contentResolver.openOutputStream(uri)
            bitmap.compress(format, 100, output)
            output?.close()
            Toast.makeText(this, "Export saved to gallery", Toast.LENGTH_SHORT).show()
        } catch (e: Exception) {
            Toast.makeText(this, "Failed to export image: ${e.message}", Toast.LENGTH_LONG).show()
        }
    }
}
